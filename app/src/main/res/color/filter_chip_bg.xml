<?xml version="1.0" encoding="utf-8"?>
<!-- Filter/select chip fill: accent when active, app background when idle (just the outline shows). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/osmo_accent" android:state_checked="true" />
    <item android:color="@android:color/transparent" />
</selector>
