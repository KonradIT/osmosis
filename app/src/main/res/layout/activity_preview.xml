<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top: filename | date taken | resolution + fps -->
    <TextView
        android:id="@+id/topInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111111"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="middle" />

    <!-- Center: LRF video player OR photo, with a spinner while it loads -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/photoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="preview"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="16dp"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Trim controls (videos only): grab in/out points from the paused scrubber position. -->
    <LinearLayout
        android:id="@+id/trimRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMarkIn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="[" />

        <Button
            android:id="@+id/btnMarkOut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="]" />
    </LinearLayout>

    <!-- Bottom: add/remove this item from the download queue -->
    <Button
        android:id="@+id/btnQueue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="Add to Queue" />
</LinearLayout>
