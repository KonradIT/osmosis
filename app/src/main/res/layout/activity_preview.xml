<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed media player. The video/photo fills the whole screen; the title is a top overlay and
  the playback + trim + queue controls are a translucent bottom overlay (custom controls, not the
  system MediaController, so trim/transport/queue live together on the player). Tapping the media
  toggles the overlays so the full frame is visible.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/photoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="preview"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Top overlay: filename · date taken · resolution·fps -->
    <TextView
        android:id="@+id/topInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC111111"
        android:ellipsize="middle"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Bottom overlay: playback + trim + queue -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <!-- Video-only controls (scrubber + transport + trim); hidden for photos -->
        <LinearLayout
            android:id="@+id/trimRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Scrubber row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Transport + trim row:  [   <<   play/pause   >>   ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMarkIn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:text="["
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnRew"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="rewind"
                    android:src="@android:drawable/ic_media_rew"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="play/pause"
                    android:src="@android:drawable/ic_media_pause"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnFf"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="fast forward"
                    android:src="@android:drawable/ic_media_ff"
                    android:tint="#FFFFFF" />

                <Button
                    android:id="@+id/btnMarkOut"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:text="]"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Favorite / heart toggle, right of the ] end-trim marker. -->
                <Button
                    android:id="@+id/btnStar"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minWidth="48dp"
                    android:text="☆"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Photos have no trim row, so their favorite toggle lives here (right-aligned above Queue). -->
        <Button
            android:id="@+id/btnStarPhoto"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minWidth="48dp"
            android:text="☆"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:visibility="gone" />

        <!-- Burst / interval frame strip: a centered 1×n row of thumbnails, built in code; the selected
             frame gets an accent border and is what "Add to Queue" queues. Shown only for a group. -->
        <HorizontalScrollView
            android:id="@+id/burstStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/burstRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add to Queue"
            android:textColor="@color/osmo_on_accent"
            app:backgroundTint="@color/osmo_accent"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconTint="@color/osmo_on_accent" />
    </LinearLayout>
</FrameLayout>
