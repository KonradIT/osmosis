<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== CAMERA SELECTOR (shown on launch) ===== -->
    <LinearLayout
        android:id="@+id/selectorGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- GPS-sync lockout banner: shown while the R-SDK link owns the camera's BLE, so media
             browsing (which needs the same link for WiFi handoff) is disabled. Tap 🛰️ to stop. -->
        <TextView
            android:id="@+id/gpsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@color/osmo_danger"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="🛰️ GPS sync active — media browsing disabled. Tap 🛰️ to stop." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="4dp"
                android:text="Cameras"
                android:textColor="@color/osmo_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="🛰️"
                android:textSize="15sp"
                app:icon="@null" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSaveLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save logs"
                android:textColor="@color/osmo_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectorHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:textColor="@color/osmo_muted"
            android:textSize="12sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/connectBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:indicatorColor="@color/osmo_accent"
            app:trackColor="@color/osmo_track"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <ListView
            android:id="@+id/cameraList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbarStyle="outsideOverlay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRescan"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rescan"
            app:icon="@android:drawable/ic_popup_sync" />
    </LinearLayout>

    <!-- ===== GALLERY (shown after connecting) ===== -->
    <FrameLayout
        android:id="@+id/gridGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <dev.konraditurbe.osmosis.ui.StatusPillView
                android:id="@+id/statusPill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp" />

            <!-- Gallery toolbar: type/faved filter chips + a Select-mode toggle (long-press = all/none). -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterPhotos"
                        style="@style/FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="Photos" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterVideos"
                        style="@style/FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="Videos" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterFaved"
                        style="@style/FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="Faved" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelect"
                        style="@style/FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Progress: invisible by default, space reserved so the grid doesn't jump. -->
            <LinearLayout
                android:id="@+id/progressArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:visibility="invisible">

                <TextView
                    android:id="@+id/overallText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/osmo_muted"
                    android:textSize="11sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/overallBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:indicatorColor="@color/osmo_accent"
                    app:trackColor="@color/osmo_track"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/fileText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/osmo_muted"
                    android:textSize="11sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/fileBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:indicatorColor="@color/osmo_green"
                    app:trackColor="@color/osmo_track"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="5dp"
                android:paddingBottom="92dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Pull-up-to-load-more spinner: rises from below as the user overscrolls past the last row,
             then spins while the next (older) page is fetched. Sits bottom-centre over the grid. -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadMoreSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/osmo_accent"
            app:indicatorSize="34dp"
            app:trackThickness="3dp" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:text="Download"
            android:textColor="@color/osmo_on_accent"
            app:backgroundTint="@color/osmo_accent"
            app:icon="@drawable/ic_download"
            app:iconTint="@color/osmo_on_accent" />
    </FrameLayout>
</LinearLayout>
