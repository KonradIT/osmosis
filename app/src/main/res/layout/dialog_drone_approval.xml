<?xml version="1.0" encoding="utf-8"?>
<!--
  The pairing-approval prompt for a drone. Unlike a camera, the aircraft has no screen of its own, so
  this view has to say *where* on the hardware to press — the illustration is the instruction.

  The white plate is not decoration: the artwork is near-black linework, which disappears entirely on
  a dark-themed dialog surface. It stays white in both themes, so the body text sits outside it and
  keeps following the theme.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/droneArt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!--
          The body is a raster, deliberately. As a VectorDrawable its linework path is 34 KB of path
          data, and a single string in the binary resource pool caps at 32,767 chars — aapt packs it
          without complaint, then at runtime PathParser is handed the literal text "STRING_TOO_LARGE"
          and throws. Splitting the path is not a safe fix either: the linework is fillType="evenOdd"
          and its subpaths nest, so any split that separates a shape from the hole punched in it fills
          the hole solid. Rendered at 3x the display size from the same source art.

          The overlay keeps the same aspect ratio and both use fitCenter (== SVG xMidYMid meet), so the
          two register on top of each other.
        -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:src="@drawable/mavic3_rear" />

        <ImageView
            android:id="@+id/powerBlink"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/drone_power_button_desc"
            android:src="@drawable/mavic3_power_face" />
    </FrameLayout>

    <TextView
        android:id="@+id/approvalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="2dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
</LinearLayout>
