<?xml version="1.0" encoding="utf-8"?>
<!-- One camera row. The card sits on top; behind it is the darkened pill holding the swipe actions
     (Stream on a camera in range, GPS sync on R-SDK models, Delete on a saved camera; the adapter
     hides what doesn't apply), uncovered when the card is dragged left. Children are positional:
     the tray first, the card second (see SwipeRevealLayout). -->
<dev.konraditurbe.osmosis.ui.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:paddingVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/swipe_well_bg"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="invisible">

        <LinearLayout
            android:id="@+id/actionStream"
            style="@style/SwipeAction"
            android:background="@drawable/swipe_action_live_bg">

            <ImageView
                style="@style/SwipeActionIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_livestream" />

            <TextView
                style="@style/SwipeActionLabel"
                android:text="@string/rtmp_tile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionGps"
            style="@style/SwipeAction"
            android:layout_marginStart="8dp"
            android:background="@drawable/swipe_action_gps_bg">

            <ImageView
                style="@style/SwipeActionIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_satellite" />

            <TextView
                style="@style/SwipeActionLabel"
                android:text="@string/gps_sync" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionDelete"
            style="@style/SwipeAction"
            android:layout_marginStart="8dp"
            android:background="@drawable/swipe_action_delete_bg">

            <ImageView
                style="@style/SwipeActionIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_trash" />

            <TextView
                style="@style/SwipeActionLabel"
                android:text="@string/delete" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/camCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/camera_row_bg"
        android:foreground="@drawable/card_ripple"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/camText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/camType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/osmo_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/camName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/osmo_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/camLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/chip_live"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="@string/live_tag"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/camTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/chip_new"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="@string/new_tag"
            android:textColor="@color/osmo_on_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/camStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/cd_camera_status"
            android:tint="@color/osmo_ink" />
    </LinearLayout>
</dev.konraditurbe.osmosis.ui.SwipeRevealLayout>
